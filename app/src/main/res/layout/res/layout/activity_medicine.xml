<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F5F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Details"
            android:textColor="#205C56"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Record your prescribed medicine information."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMedicineName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Medicine name"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dosage"
            android:textColor="#205C56"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/etDosage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/medisync_input"
            android:padding="8dp"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/etCustomDosage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Enter prescribed dosage"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequency"
            android:textColor="#205C56"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/etFrequency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/medisync_input"
            android:padding="8dp"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/etCustomFrequency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Enter prescribed frequency"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder Time"
            android:textColor="#205C56"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/etTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select reminder time"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Date"
            android:textColor="#205C56"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/etStartDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select start date"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Date"
            android:textColor="#205C56"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/etEndDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select end date"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <Button
            android:id="@+id/btnSaveMedicine"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#31877E"
            android:text="Save Medicine"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>

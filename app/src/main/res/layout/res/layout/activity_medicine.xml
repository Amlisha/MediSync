<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- PAGE HEADING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Details"
            android:textColor="#205C56"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Manage your prescribed medicines."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- HEADER BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/medisync_welcome_banner"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDICINE MANAGEMENT"
                android:textColor="#B3E1DA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Stay on track with your medicines."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keep your medicine details and schedules organized."
                android:textColor="#E0F3EE"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- SECTION HEADING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"
            android:text="Medicine Information"
            android:textColor="#205C56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- MEDICINE NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMedicineName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter medicine name"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- DOSAGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosage"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/etDosage"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/medisync_input"
                android:padding="12dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/etCustomDosage"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter prescribed dosage"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:visibility="gone" />

            <!-- FREQUENCY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequency"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/etFrequency"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/medisync_input"
                android:padding="12dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/etCustomFrequency"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter prescribed frequency"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:visibility="gone" />

            <!-- REMINDER TIME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Time"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select reminder time"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- START DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Date"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStartDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select start date"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- END DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Date"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEndDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select end date"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveMedicine"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#205C56"
                android:text="Save Medicine"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Follow the dosage and schedule prescribed by your doctor."
            android:textColor="#426D68"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

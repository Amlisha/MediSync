<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- PAGE HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment Reminder"
            android:textColor="#205C56"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Plan your doctor visits with ease."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- HEADER BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/medisync_welcome_banner"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAY ON SCHEDULE"
                android:textColor="#B3E1DA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Your health, your time."
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Schedule your next medical visit and receive a timely reminder."
                android:textColor="#E0F3EE"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- SECTION HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Appointment Details"
            android:textColor="#205C56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- DOCTOR NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor's Name"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDoctorName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter doctor's name"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- HOSPITAL NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital / Clinic"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHospitalName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter hospital or clinic name"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- APPOINTMENT DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Date"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:hint="Select appointment date"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- APPOINTMENT TIME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Time (24-hour)"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAppointmentTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:hint="Select time (e.g. 14:30)"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- NOTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional Notes (Optional)"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAppointmentDescription"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/medisync_input"
                android:gravity="top|start"
                android:hint="E.g. Follow-up consultation, blood test..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveAppointment"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#205C56"
                android:text="Save Appointment"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="A little planning makes every appointment easier."
            android:textColor="#426D68"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>

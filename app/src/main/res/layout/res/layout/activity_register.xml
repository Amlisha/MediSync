<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E3F5F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♥ MediSync"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#205C56"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your account"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#205C56"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join MediSync to organise your health."
            android:textSize="14sp"
            android:textColor="#426D68"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etRegisterUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Username"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Confirm password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C"
            android:background="@drawable/medisync_input" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:backgroundTint="#31877E"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="Already have an account? Login"
            android:textSize="14sp"
            android:textColor="#28796F"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
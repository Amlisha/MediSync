<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- APP BRANDING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/medisync_welcome_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- APP ICON -->
            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/card_reminders"
                android:gravity="center"
                android:text="&#9829;"
                android:textColor="#205C56"
                android:textSize="36sp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MediSync"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your Health Companion"
                android:textColor="#D8F3EC"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- REGISTRATION HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Create Your Account"
            android:textColor="#205C56"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:text="Join MediSync to organize your health."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- REGISTRATION FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- FULL NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#205C56"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- USERNAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#205C56"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/medisync_input"
                android:hint="Choose a username"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#205C56"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/medisync_input"
                android:hint="Create a password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- CONFIRM PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="#205C56"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/medisync_input"
                android:hint="Re-enter your password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- CREATE ACCOUNT BUTTON -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#205C56"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LOGIN LINK -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="10dp"
            android:text="Already have an account? Login"
            android:textColor="#28796F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="Your health, organized in one place."
            android:textColor="#426D68"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>

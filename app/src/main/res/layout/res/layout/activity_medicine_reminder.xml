<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- PAGE HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medicine Reminder"
            android:textColor="#205C56"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Make every dose count."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- HEADER BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/medisync_welcome_banner"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDICINE SCHEDULE"
                android:textColor="#B3E1DA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Stay on track, every day."
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Set a reminder for your medicine and stay consistent with your routine."
                android:textColor="#E0F3EE"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- MEDICINE DETAILS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Selected Medicine"
            android:textColor="#205C56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/card_record"
                android:gravity="center"
                android:text="&#128138;"
                android:textSize="24sp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvMedicineInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Saved medicine details will appear here."
                android:textColor="#205C56"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- FORM SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Schedule Reminder"
            android:textColor="#205C56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- REMINDER DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Date"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etReminderDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select reminder date"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawablePadding="8dp"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- REMINDER TIME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Time (24-hour)"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etReminderTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/medisync_input"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Select time (e.g. 20:45)"
                android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                android:drawablePadding="8dp"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- NOTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional Notes (Optional)"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etReminderDescription"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/medisync_input"
                android:gravity="top|start"
                android:hint="E.g. Take after dinner"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="15sp" />

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveMedicineReminder"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#205C56"
                android:text="Save Reminder"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Your health routine, made simpler."
            android:textColor="#426D68"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>

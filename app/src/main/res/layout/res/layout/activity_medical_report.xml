<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F5F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical Report"
            android:textColor="#205C56"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Keep a record of your medical visits and reports."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etReportName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Report name (required)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <EditText
            android:id="@+id/etDoctorName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Doctor's name"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <EditText
            android:id="@+id/etHospitalName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Hospital or clinic name"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />


        <EditText
            android:id="@+id/etReportDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/medisync_input"
            android:hint="Select report date"
            android:focusable="false"
            android:cursorVisible="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="8dp"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />


        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/medisync_input"
            android:gravity="top"
            android:hint="Description or important findings"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textColor="#205C56"
            android:textColorHint="#72918C" />

        <Button
            android:id="@+id/btnSaveReport"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:minWidth="180dp"
            android:backgroundTint="#31877E"
            android:text="Save Report"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
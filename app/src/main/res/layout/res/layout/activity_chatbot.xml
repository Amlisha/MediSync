<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2FBF8"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MediBot"
        android:textColor="#205C56"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your offline health assistant"
        android:textColor="#426D68"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore a topic"
        android:textColor="#205C56"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:paddingBottom="4dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHealthyHabits"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:minHeight="0dp"
                android:text="Healthy habits"
                android:textAllCaps="false"
                android:backgroundTint="#D8F3EC"
                android:textColor="#205C56" />

            <Button
                android:id="@+id/btnMedicineHelp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:minHeight="0dp"
                android:text="Medicine safety"
                android:textAllCaps="false"
                android:backgroundTint="#D8F3EC"
                android:textColor="#205C56" />

            <Button
                android:id="@+id/btnAppointmentHelp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:minHeight="0dp"
                android:text="Appointments"
                android:textAllCaps="false"
                android:backgroundTint="#D8F3EC"
                android:textColor="#205C56" />

            <Button
                android:id="@+id/btnAppHelp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:minHeight="0dp"
                android:text="Using MediSync"
                android:textAllCaps="false"
                android:backgroundTint="#D8F3EC"
                android:textColor="#205C56" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat with MediBot"
        android:textColor="#205C56"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/medisync_input"
            android:hint="Ask MediBot..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#31877E"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:text="🎤"
            android:contentDescription="Speak your question" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:textAllCaps="false"
            android:backgroundTint="#31877E"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>

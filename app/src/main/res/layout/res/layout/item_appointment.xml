<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/medisync_card"
    android:elevation="2dp"
    android:padding="16dp">

    <!-- APPOINTMENT HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <!-- CALENDAR ICON -->
        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/card_reminders"
            android:gravity="center"
            android:text="&#128197;"
            android:textSize="23sp"
            android:importantForAccessibility="no" />

        <!-- HEADER TEXT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEALTH SCHEDULE"
                android:textColor="#31877E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Doctor Appointment"
                android:textColor="#205C56"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- APPOINTMENT DETAILS -->
    <TextView
        android:id="@+id/tvAppointmentDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/medisync_input"
        android:padding="15dp"
        android:text="Doctor&#10;Hospital&#10;Date and Time"
        android:textColor="#205C56"
        android:textSize="14sp"
        android:lineSpacingExtra="5dp" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- EDIT BUTTON -->
        <Button
            android:id="@+id/btnEditAppointment"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#31877E"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <!-- DELETE BUTTON -->
        <Button
            android:id="@+id/btnDeleteAppointment"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B85C65"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CDEDE7"
    android:padding="18dp">

    <!-- PAGE HEADING -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Medicines"
        android:textColor="#205C56"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="View and manage your saved medicines."
        android:textColor="#426D68"
        android:textSize="14sp" />

    <!-- HEADER BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/medisync_welcome_banner"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR MEDICINE RECORDS"
            android:textColor="#B3E1DA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your medicines, organized."
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Keep track of your prescribed medicines."
            android:textColor="#E0F3EE"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ADD BUTTON -->
    <Button
        android:id="@+id/btnAddMedicine"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:backgroundTint="#205C56"
        android:text="+ Add New Medicine"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- SECTION TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Saved Medicines"
        android:textColor="#205C56"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/tvEmptyMedicines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/medisync_card"
        android:gravity="center"
        android:padding="24dp"
        android:text="No medicines saved yet.\nTap Add New Medicine to get started."
        android:textColor="#426D68"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- MEDICINE LIST -->
    <ListView
        android:id="@+id/lvMedicines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#CDEDE7"
        android:divider="#A8DCD4"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>

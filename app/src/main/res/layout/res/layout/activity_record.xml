<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- PAGE HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Records"
            android:textColor="#205C56"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your important medical information, all in one place."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- HEADER BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/medisync_welcome_banner"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR HEALTH INFORMATION"
                android:textColor="#B3E1DA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Everything you need, organized."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Access and manage your personal health details whenever you need them."
                android:textColor="#E0F3EE"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="14dp"
            android:text="Manage Information"
            android:textColor="#205C56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- HEALTH PROFILE -->
        <TextView
            android:id="@+id/btnHealthProfile"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_record"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="♡   Health Profile\n       Personal health information"
            android:textColor="#205C56"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- MEDICINE DETAILS -->
        <TextView
            android:id="@+id/btnMedicine"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_reminders"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="✚   Medicine Details\n       Manage your medicines"
            android:textColor="#205C56"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- MEDICAL REPORTS -->
        <TextView
            android:id="@+id/btnMedicalReport"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_resolve"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="▤   Medical Reports\n       Store your medical records"
            android:textColor="#205C56"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- EMERGENCY CONTACT -->
        <TextView
            android:id="@+id/btnEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_emergency"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="☎   Emergency Contacts\n       Manage emergency numbers"
            android:textColor="#205C56"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- APPOINTMENT DETAILS -->
        <TextView
            android:id="@+id/btnAppointmentReminder"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_record"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="◷   Appointment Details\n       View your appointments"
            android:textColor="#205C56"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F5F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminders"
            android:textColor="#205C56"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Keep track of medicines and appointments."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMedicineReminder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/medisync_input"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:text="Medicine Reminder"
            android:textAllCaps="false"
            android:textColor="#205C56"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAppointmentReminder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/medisync_input"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:text="Appointment Reminder"
            android:textAllCaps="false"
            android:textColor="#205C56"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>

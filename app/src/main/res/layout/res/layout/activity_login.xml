<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CDEDE7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- APP BRANDING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/medisync_welcome_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- APP ICON -->
            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/card_reminders"
                android:gravity="center"
                android:text="&#9829;"
                android:textColor="#205C56"
                android:textSize="38sp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="MediSync"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your Health Companion"
                android:textColor="#D8F3EC"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- LOGIN HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Welcome Back!"
            android:textColor="#205C56"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:text="Sign in to continue your health journey."
            android:textColor="#426D68"
            android:textSize="14sp" />

        <!-- LOGIN FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medisync_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- USERNAME LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- USERNAME INPUT -->
            <EditText
                android:id="@+id/etLoginUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter your username"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- PASSWORD LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#205C56"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- PASSWORD INPUT -->
            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/medisync_input"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#205C56"
                android:textColorHint="#72918C"
                android:textSize="14sp" />

            <!-- REMEMBER ME -->
            <CheckBox
                android:id="@+id/cbRememberMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:buttonTint="#31877E"
                android:text="Remember Me"
                android:textColor="#205C56"
                android:textSize="14sp" />

            <!-- LOGIN BUTTON -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#205C56"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- REGISTER LINK -->
        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="10dp"
            android:text="Don't have an account? Register"
            android:textColor="#28796F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Your health, organized in one place."
            android:textColor="#426D68"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CDEDE7"
    android:padding="18dp">

    <!-- PAGE HEADING -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Contacts"
        android:textColor="#205C56"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Keep your trusted contacts close."
        android:textColor="#426D68"
        android:textSize="14sp" />

    <!-- HEADER BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/medisync_welcome_banner"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR SAFETY NETWORK"
            android:textColor="#B3E1DA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stay connected. Stay prepared."
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your important contacts, organized and ready when you need them."
            android:textColor="#E0F3EE"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ADD CONTACT BUTTON -->
    <Button
        android:id="@+id/btnAddContact"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:backgroundTint="#205C56"
        android:text="+ Add New Contact"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- SECTION TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Saved Contacts"
        android:textColor="#205C56"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- EMPTY MESSAGE -->
    <TextView
        android:id="@+id/tvEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/medisync_card"
        android:gravity="center"
        android:padding="24dp"
        android:text="No emergency contacts added yet."
        android:textColor="#426D68"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- CONTACT LIST -->
    <ListView
        android:id="@+id/lvEmergencyContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#CDEDE7"
        android:divider="#A8DCD4"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>

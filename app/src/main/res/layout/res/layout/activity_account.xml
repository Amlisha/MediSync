<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FFFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♥ MediSync"
            android:textColor="#205C56"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Health Companion"
            android:textColor="#426D68"
            android:textSize="15sp" />

        <!-- User Account Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/medisync_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="#DDF4EE"
                android:gravity="center"
                android:text="♙"
                android:textColor="#31877E"
                android:textSize="48sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Account"
                    android:textColor="#205C56"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Your username"
                    android:textColor="#426D68"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Account Details -->
        <TextView
            android:id="@+id/btnAccountDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="true"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:padding="18dp"
            android:text="♙   Account Details\n      View your account information     ›"
            android:textColor="#205C56"
            android:textSize="16sp" />

        <!-- Change Password -->
        <TextView
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:padding="18dp"
            android:text="♙   Change Password\n      Update your account password     ›"
            android:textColor="#205C56"
            android:textSize="16sp" />

        <!-- App Settings -->
        <TextView
            android:id="@+id/btnAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:padding="18dp"
            android:text="⚙   App Settings\n      Manage app preferences             ›"
            android:textColor="#205C56"
            android:textSize="16sp" />

        <!-- About MediSync -->
        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:padding="18dp"
            android:text="ⓘ   About MediSync\n      Version, help and support           ›"
            android:textColor="#205C56"
            android:textSize="16sp" />

        <!-- Log Out -->
        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFF0F0"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:padding="20dp"
            android:text="↪   Log Out\n      Sign out of your account"
            android:textColor="#A52A45"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/medisync_card"
    android:elevation="2dp"
    android:padding="16dp">

    <!-- REPORT HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- REPORT ICON -->
        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/card_record"
            android:gravity="center"
            android:text="▤"
            android:textColor="#205C56"
            android:textSize="25sp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDICAL RECORD"
                android:textColor="#31877E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Report Details"
                android:textColor="#205C56"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- REPORT INFORMATION -->
    <TextView
        android:id="@+id/tvReportDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/medisync_input"
        android:padding="15dp"
        android:textColor="#205C56"
        android:textSize="14sp"
        android:lineSpacingExtra="5dp" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnEditReport"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#31877E"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDeleteReport"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#B85C65"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CDEDE7"
    android:padding="18dp">

    <!-- PAGE HEADING -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medical Reports"
        android:textColor="#205C56"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="View and manage your saved medical reports."
        android:textColor="#426D68"
        android:textSize="14sp" />

    <!-- HEADER BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/medisync_welcome_banner"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR MEDICAL HISTORY"
            android:textColor="#B3E1DA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your reports, all in one place."
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Easily access and organize your medical information."
            android:textColor="#E0F3EE"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ADD REPORT BUTTON -->
    <Button
        android:id="@+id/btnAddReport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#205C56"
        android:text="+ Add New Report"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- SEARCH LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Search Reports"
        android:textColor="#205C56"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- SEARCH FIELD -->
    <EditText
        android:id="@+id/etSearchReports"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/medisync_input"
        android:hint="Search by title, doctor or hospital"
        android:inputType="text"
        android:singleLine="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#205C56"
        android:textColorHint="#72918C"
        android:textSize="14sp" />

    <!-- SECTION TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Saved Reports"
        android:textColor="#205C56"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- EMPTY MESSAGE -->
    <TextView
        android:id="@+id/tvEmptyReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/medisync_card"
        android:gravity="center"
        android:padding="24dp"
        android:text="No medical reports saved yet."
        android:textColor="#426D68"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- SAVED REPORTS LIST -->
    <ListView
        android:id="@+id/lvMedicalReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#CDEDE7"
        android:divider="#A8DCD4"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
